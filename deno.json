{
  "tasks": {
    "dev": {
      "command": "deno x --unstable-bare-node-builtins @tinacms/cli dev",
      "description": "Start dev server"
    },
    "build": {
      "command": "deno x --unstable-bare-node-builtins @tinacms/cli build --skip-indexing --skip-cloud-checks --skip-search-index && rm dist/.gitignore",
      "description": "Build artifact"
    },
    "lint:content": {
      "command": "deno x --unstable-bare-node-builtins @tinacms/cli audit",
      "description": "Audit content"
    },
    "lint": {
      "command": "deno task \"lint:*\"",
      "description": "Static check"
    }
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@^1.0.23",
    "@std/path": "jsr:@std/path@^1.1.4",
    "@std/yaml": "jsr:@std/yaml@^1.0.12",
    "@tinacms/cli": "npm:@tinacms/cli@^2.1.6",
    "@tinacms/schema-tools": "npm:@tinacms/schema-tools@^2.6.0",
    "ajv": "npm:ajv@^8.18.0",
    "gray-matter": "npm:gray-matter@^4.0.3",
    "i18next": "npm:i18next@^25.8.13",
    "json-schema": "npm:json-schema@^0.4.0",
    "remark-frontmatter": "npm:remark-frontmatter@^5.0.0",
    "remark-lint-frontmatter-schema": "npm:remark-lint-frontmatter-schema@^3.15.4",
    "tinacms": "npm:tinacms@^3.5.0"
  },
  "nodeModulesDir": "auto",
  "lint": {
    "rules": {
      "include": [
        "camelcase",
        "ban-untagged-todo",
        "default-param-last",
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-eval",
        "no-external-import",
        "no-import-prefix",
        "no-inferrable-types",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-slow-types",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-top-level-await",
        "no-useless-rename",
        "prefer-ascii",
        "single-var-declarator",
        "verbatim-module-syntax"
      ]
    }
  }
}
