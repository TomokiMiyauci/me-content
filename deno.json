{
  "tasks": {
    "dev": {
      "command": "deno x --unstable-bare-node-builtins @tinacms/cli dev",
      "description": "Start dev server"
    },
    "build": {
      "command": "deno x --unstable-bare-node-builtins @tinacms/cli build --skip-indexing --skip-cloud-checks --skip-search-index && rm dist/.gitignore",
      "description": "Build artifact"
    },
    "lint:schema": {
      "command": "deno x --unstable-bare-node-builtins @tinacms/cli audit",
      "description": "Lint schema"
    },
    "lint:content": {
      "command": "deno run --allow-read @miyauci/tina-audit-plus/run",
      "description": "Lint content"
    },
    "lint:deno": {
      "command": "deno lint",
      "description": "Lint by Deno"
    },
    "lint:markdown": {
      "command": "deno x markdownlint content",
      "description": "Lint by markdownlint"
    },
    "lint:textlint": {
      "command": "deno x textlint content",
      "description": "Lint by textlint"
    },
    "lint": {
      "command": "deno task \"lint:*\"",
      "description": "Static check"
    }
  },
  "imports": {
    "@tinacms/cli": "npm:@tinacms/cli@^2.1.6",
    "i18next": "npm:i18next@^25.8.13",
    "markdownlint-cli": "npm:markdownlint-cli@^0.47.0",
    "textlint": "npm:textlint@^15.5.2",
    "textlint-rule-preset-japanese": "npm:textlint-rule-preset-japanese@^10.0.4",
    "tinacms": "npm:tinacms@^3.5.0"
  },
  "nodeModulesDir": "auto",
  "lint": {
    "rules": {
      "include": [
        "camelcase",
        "ban-untagged-todo",
        "default-param-last",
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-eval",
        "no-external-import",
        "no-import-prefix",
        "no-inferrable-types",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-slow-types",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-top-level-await",
        "no-useless-rename",
        "prefer-ascii",
        "single-var-declarator",
        "verbatim-module-syntax"
      ]
    }
  },
  "workspace": ["packages/tina_audit", "packages/tina_lock"]
}
