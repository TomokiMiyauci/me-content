{
  "tasks": {
    "build": "deno run -A scripts/build.ts",
    "lint:textlint": {
      "command": "deno x textlint content",
      "description": "Lint by textlint"
    }
  },
  "imports": {
    "@cosmos/field-codec": "npm:@TomokiMiyauci/field-codec@^0.1.14",
    "@cosmos/resolver-path": "npm:@TomokiMiyauci/resolver-path@^0.1.14",
    "@cosmos/field-union": "npm:@TomokiMiyauci/codec-union@^0.1.14",
    "i18next": "npm:i18next@^26.0.7",
    "markdownlint-cli": "npm:markdownlint-cli@^0.48.0",
    "@cosmos/core": "npm:@TomokiMiyauci/cosmos@0.1.14",
    "@cosmos/delivery": "npm:@TomokiMiyauci/delivery@0.1.14",
    "@cosmos/codec-asset": "npm:@TomokiMiyauci/codec-asset@0.1.14",
    "@cosmos/codec-boolean": "npm:@TomokiMiyauci/codec-boolean@0.1.14",
    "@cosmos/codec-datetime": "npm:@TomokiMiyauci/codec-datetime@^0.1.14",
    "@cosmos/codec-instance": "npm:@TomokiMiyauci/codec-instance@0.1.14",
    "@cosmos/codec-list": "npm:@TomokiMiyauci/codec-list@0.1.14",
    "@cosmos/codec-map": "npm:@TomokiMiyauci/codec-map@0.1.14",
    "@cosmos/codec-markdown": "npm:@TomokiMiyauci/codec-markdown@0.1.14",
    "@cosmos/codec-number": "npm:@TomokiMiyauci/codec-number@0.1.14",
    "@cosmos/codec-path-reference": "npm:@TomokiMiyauci/codec-path-reference@^0.1.14",
    "@cosmos/codec-string": "npm:@TomokiMiyauci/codec-string@0.1.14",
    "@cosmos/formatter-frontmatter": "npm:@TomokiMiyauci/formatter-frontmatter@0.1.14",
    "@cosmos/formatter-json": "npm:@TomokiMiyauci/formatter-json@0.1.14",
    "@cosmos/formatter-text": "npm:@TomokiMiyauci/formatter-text@0.1.14",
    "@cosmos/formatter-yaml": "npm:@TomokiMiyauci/formatter-yaml@0.1.14",
    "@cosmos/index-fs": "npm:@TomokiMiyauci/index-fs@0.1.14",
    "@cosmos/indexer": "npm:@TomokiMiyauci/indexer@0.1.14",
    "@cosmos/protocol-graphql": "npm:@TomokiMiyauci/protocol-graphql@0.1.14",
    "@cosmos/storage-fs": "npm:@TomokiMiyauci/storage-fs@0.1.14",
    "@cosmos/store-sqlite": "npm:@TomokiMiyauci/store-sqlite@0.1.14",
    "@std/path": "jsr:@std/path@^1.1.4"
  },
  "lint": {
    "rules": {
      "include": [
        "camelcase",
        "ban-untagged-todo",
        "default-param-last",
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-eval",
        "no-external-import",
        "no-import-prefix",
        "no-inferrable-types",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-slow-types",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-top-level-await",
        "no-useless-rename",
        "prefer-ascii",
        "single-var-declarator",
        "verbatim-module-syntax"
      ]
    }
  }
}
